# ==============================================================================
# SHARED MONOREPO ENVIRONMENT (.env)
# Single source of truth for both Frontend (Next.js) and Backend (FastAPI).
# NOTE: Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser!
# Never prefix secret keys (DATABASE_URL, SECRET_KEY, LLM API keys) with NEXT_PUBLIC_.
# ==============================================================================

# --- Frontend (Browser-Exposed) ---
NEXT_PUBLIC_APP_NAME="Heketon"
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# --- Backend Application ---
PROJECT_NAME="Heketon API"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Security / JWT ---
SECRET_KEY="change-this-secret-key-in-production-use-openssl-rand-hex-32"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database (Supabase / Managed PostgreSQL) ---
# For Async SQLAlchemy + Alembic, use postgresql+asyncpg://
# Tip (Supabase): Use port 5432 (Session mode / Direct) for Alembic migrations,
# or add ?prepared_statement_cache_size=0 if using port 6543 (Supavisor Transaction Pooler).
DATABASE_URL="postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
LANGGRAPH_CHECKPOINT_DB_URI="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
SUPABASE_SERVICE_ROLE_KEY=""

# --- AI / LLM Providers (Shared by FastAPI LangChain/LangGraph & Next.js Vercel AI SDK Server Routes) ---
OPENAI_API_KEY=""
GOOGLE_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""
ANTHROPIC_API_KEY=""
GROQ_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"
